// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "background: pack",
            "type": "shell",
            "icon": {
                "id": "package",
                "tooltip": "升版（patch+1）→ compile → vsce → dist/background-<version>.vsix"
            },
            "command": "bash abs/sh/pack-background.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "background: pack (no-bump)",
            "type": "shell",
            "icon": {
                "id": "archive",
                "tooltip": "按当前 package.json 版本打包（不升版）"
            },
            "command": "bash abs/sh/pack-background.sh --no-bump",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "background: install",
            "type": "shell",
            "icon": {
                "id": "extensions",
                "tooltip": "选 dist vsix → cursor/code 安装 → 清旧扩展目录"
            },
            "command": "bash abs/sh/install-background.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "background: all",
            "type": "shell",
            "icon": {
                "id": "rocket",
                "tooltip": "pack（升版）→ install 一条龙"
            },
            "command": "bash abs/sh/install-background.sh --pack",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
